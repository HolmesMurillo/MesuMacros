    "lint": "oxlint",
    "preview": "vite preview",
    "catalog:review": "node --env-file=.env.local scripts/buildFoodCatalog.mjs",
    "catalog:apply": "node --env-file=.env.local scripts/buildFoodCatalog.mjs --apply",
    "catalog:finalize": "node scripts/finalizeFoodCatalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
